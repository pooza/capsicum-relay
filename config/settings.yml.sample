# capsicum-relay 設定ファイル
# コピーして config/settings.yml として配置

# capsicum からの登録リクエスト認証用
shared_secret: "CHANGE_ME"

# APNs (iOS)
# sandbox: true でサンドボックス環境（開発ビルド用）に接続
apns:
  key_path: "/path/to/AuthKey_XXXXXXXXXX.p8"
  key_id: "XXXXXXXXXX"
  team_id: "XXXXXXXXXX"
  bundle_id: "org.b-shock.capsicum"
  sandbox: false

# FCM (Android)
fcm:
  project_id: "capsicum-xxxxx"
  service_account_path: "/path/to/service-account.json"

# WNS (Windows) — capsicum#474
# package_sid / client_secret は Microsoft Partner Center + Azure AD で発行する
# Package SID（ms-app://S-1-15-...）と client secret（レガシー Package SID 方式）。
# package_sid 未設定なら WNS クライアントは初期化されず、windows 宛 push は 503。
wns:
  package_sid: "ms-app://S-1-15-2-..."
  client_secret: "CHANGE_ME"

# Apple の購入の検証 (#61) — App Store Server API
# 鍵は **アプリ内課金キー**（App Store Connect → ユーザとアクセス → 統合 → アプリ内課金）。
# ⚠ 期限は無い（失効は手動の revoke だけ・revoke されると 401 で error ログ）。
# issuer_id は App Store Connect API キーと同じ（チーム共通）。
# environments は引く順。⚠ 本番は Production → Sandbox（TestFlight の購入を扱う・
#   テスターは身内だけの前提）、ステージングは Sandbox だけ。
# 節ごと無ければ検証しない（購入は unverified のまま・通知の受け口は 503）。
# app_store:
#   key_path: "/path/to/SubscriptionKey_XXXXXXXXXX.p8"
#   key_id: "XXXXXXXXXX"
#   issuer_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
#   bundle_id: "org.b-shock.capsicum"
#   environments: ["Production", "Sandbox"]
#   product_ids: ["supporter.relay.monthly"]   # 利用権として扱う商品（省略時はこの値・#89）
#   reverify_interval: 600   # unverified の購入を確かめ直す間隔（秒・0 で止める）

# Google の購入の検証 (#62) — Play Developer API + リアルタイム デベロッパー通知（RTDN）
# サービスアカウントは **relay 専用**（Firebase 用とは分ける）。Play Console の
# 「ユーザーと権限」で招待し、アプリの注文とサブスクの権限を付ける。
# push_audience / push_service_account は Pub/Sub の push の購読に設定した値
# （OIDC トークンの宛先と送り手を照合する）。
# 節ごと無ければ検証しない（購入は unverified のまま・通知の受け口は 503）。
# google_play:
#   package_name: "net.shrieker.capsicum"
#   service_account_path: "/path/to/capsicum-relay-play.json"
#   product_ids: ["supporter.relay.monthly"]   # 利用権として扱う商品（省略時はこの値・#89）
#   push_audience: "https://relay.example/store/google/notifications"
#   push_service_account: "xxx@capsicum-xxxxx.iam.gserviceaccount.com"

# お知らせ通知 push (capsicum-relay#14)
# poll_interval を 0 にすると polling worker を無効化 (テスト用)
announcement:
  poll_interval: 60

# プリセット（capsicum 運営元）サーバーの判定に**足す**ホスト (capsicum#597 / #59)
# ⚠ 一覧の正本は lib/relay/preset_servers.rb（capsicum の preset_servers.dart の写し）。
# ⚠⚠ ここは足すことしかできない。置き換えにしていないのは、書き忘れたデプロイで
#     全登録が非プリセット扱いになるのを防ぐため（フェーズ 3 では全員のゲートが閉じる）。
# extra_preset_hosts:
#   - "example.test"

# プリセットの名乗りを裏取りするときに要求する VAPID の `aud` (capsicum#597 / #69)。
#
# ⚠⚠ **必ず書くこと。**未設定だと裏取りができず、プリセットを名乗る push は
#     すべて fail-open で通る（`relay_vapid_verification_total` の
#     `outcome="audience_unconfigured"` が立つ）。
#
# ⚠⚠ **リクエストのヘッダから組んではいけない**ので設定で持つ。Rack の
#     `request.host` は `X-Forwarded-Host` を見るうえ、nginx.conf.sample は
#     そのヘッダを消していない。組んでいた版では、攻撃者が
#     `X-Forwarded-Host: attacker.example` を添えるだけで**期待値ごと攻撃者の
#     値になり、照合が素通りした**（#69・PR #77 の Codex 2 巡目）。
#
# ⚠ **fedi サーバーが push を投げる先の origin をそのまま書く。**
#     本番 = https://relay.capsicum.shrieker.net / ステージング = https://st.relay...
# ⚠ 1 台で複数の名前を受けるなら配列で並べてよい。
# ⚠ 合っていないと本物の push が全部 `audience_mismatch` になるので、変えたら
#     `relay_vapid_verification_total` を読むこと。
relay_audience: "https://relay.example.net"

# 認可ゲート (capsicum#597 / #60) は **env** で切り替える（設定ファイルではない）。
# ⚠⚠ 既定は無効（何も閉じない）。本番で立てるのはフェーズ 3 の決定で、
#     立てる前に relay_register_entitlement_total を読み直すこと。
#   systemd drop-in 例: Environment=RELAY_ENTITLEMENT_ENFORCE=true

# 配送の非同期化 (#55) も **env**。
#   PUSH_QUEUE_CAPACITY=200  積める通数（⚠ 深くしない）
#   PUSH_QUEUE_WORKERS=2     配送の並行数
# ⚠⚠ WORKERS を増やすときは lib/relay/http_connection_pool.rb の
#     MAX_IDLE_PER_HOST も揃えること（超えたぶんは閉じられ、#54 の再利用が効かない）。
